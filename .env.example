# Local development. Copy this file to .env and keep .env private.
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
AUTH_DISABLED=true

# Server-side only. Never expose these values to browser code.
OPENAI_API_KEY=
DATABASE_URL=
CRAWLER_API_TOKEN=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Never expose with a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
SEARCH_API_KEY=
FIRECRAWL_API_KEY=
